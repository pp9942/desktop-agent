# 复制成 .env 再填。.env 不能进仓库。
OPENAI_API_KEY=
# 任何 OpenAI 兼容的服务都行：DeepSeek / 通义 / Moonshot / OpenAI
OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.2

# 工作区（留空则用项目自带的 workspace/）
AGENT_WORKSPACE=

# 三道护栏
AGENT_MAX_STEPS=20
AGENT_STEP_TIMEOUT=180
AGENT_BASH_TIMEOUT=60

# 没有 Key 时打开这个，用脚本化的假模型跑通整条链路
AGENT_MOCK=0
